{
  "expo": {
    "name": "Aarohan Healthcare",
    "slug": "aarohan-healthcare",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-secure-store"
    ],
    "android": {
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS"
      ]
    },
    "ios": {
      "infoPlist": {
        "NSCameraUsageDescription": "This app needs camera access for video consultations with doctors.",
        "NSMicrophoneUsageDescription": "This app needs microphone access for video consultations with doctors."
      }
    },
    "extra": {
      "BACKEND_URL": "http://192.168.137.192:8000"
    }
  }
}